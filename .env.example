# Base(EVM) 署名バックエンド: circle = Circle DCW で署名(本番) / privatekey = ローカル EOA(既定)
SIGNER_BACKEND=            # circle | privatekey (未設定時は privatekey)

# x402マイクロペイメント用EOAウォレット（秘密鍵。SIGNER_BACKEND=privatekey のとき必須）
PAYMENT_PRIVATE_KEY=  # 0xで始まる64桁の16進数秘密鍵 (USDCをBase mainnetで保有すること)

# Circle DCW EVM ウォレット (SIGNER_BACKEND=circle のとき Base 決済の署名に使用)
CIRCLE_EVM_WALLET_ID=       # Circle console で確認
CIRCLE_EVM_WALLET_ADDRESS=  # 0x... (Base mainnet の USDC を保有すること)

# Anthropic
ANTHROPIC_API_KEY=

# Portfolio Intelligence — 分析対象ウォレットアドレス
PORTFOLIO_ANALYZE_TARGET=  # 例: 0x...

# モードB エンドポイント URL overrides (任意 — 未設定時はデフォルト値を使用)
APAC_MACRO_URL=
YIELD_INTELLIGENCE_URL=
PORTFOLIO_INTELLIGENCE_URL=
JAPAN_REAL_ESTATE_URL=
DIVERGENCE_ANALYZER_URL=
PRIVATE_MARKET_URL=
# 既定は ?chain=base 付き。Solana に向けると Nansen が非対応で tokens:[] が返る。
# chain 以外のパラメータ名だった場合はここにクエリ込みの完全な URL を入れる。
SMART_MONEY_SCREENER_URL=
ONCHAIN_FEED_APAC_URL=
ONCHAIN_FEED_WHALE_URL=

# モードA 日次判断ループ (2026-09〜 Smart Money Screener 一本。課金なし)
ERC8004_AGENT_ID=             # 日次 call を紐付ける ERC-8004 agentId (未設定時は 55560)
# 候補にする行の閾値。screener が populated になってから実データを見て決める。
# 既定は緩め(0/0/1)。Mode A はもう課金しないので、緩い閾値のコストは記録1件であって金額ではない。
SMS_MIN_SCORE=                # score がこの値以上 (未設定時は 0)
SMS_MIN_NET_FLOW_USD=         # |net flow 24h| がこの額以上 (未設定時は 0)
SMS_MIN_SM_WALLETS=           # SM wallets がこの数以上 (未設定時は 1)
# Whale Intent Decoder / Hyperliquid Intelligence は Mode A の経路から外れ、
# HYPERLIQUID_INTELLIGENCE_URL / WHALE_INTENT_DECODER_URL / HL_DIVERGENCE_MIN_SCORE は
# もう読まれない。

# モードA 判断記録ストア (Upstash Redis REST。未設定時はローカル JSONL のみに追記)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# モードC エンドポイント URL overrides (任意)
APAC_MACRO_WEEKLY_URL=
YIELD_INTELLIGENCE_WEEKLY_URL=
JAPAN_REAL_ESTATE_WEEKLY_URL=
ALPHA_MEMO_WEEKLY_URL=
ONCHAIN_FEED_WEEKLY_URL=

# osd consumption ジョブ (Phase A: catalyst の投稿と採点の往復)
# 有料データ消費 (stocks/{ticker}, /api/predict, /api/liquidity, /api/holders) は
# 2026-08 に osd 側でルートごと廃止されたため削除済み。
# 関連していた OSD_DATA_SPEND_CAP_USD / OSD_DATA_TICKERS_PER_RUN /
# OSD_PREMIUM_WEEKLY_DAY はもう読まれない。
OSD_API_BASE=https://osd.x402jp.com   # 任意: 叩き先 base_url
OSD_SUBMIT_MAX_PER_RUN=1                     # 1 run の catalyst submit 件数 (IP レート制限対策)

# Mode D — osd alpha/track-record 消費 (Solana USDC per-call, x402)
OSD_API_BASE=https://osd.x402jp.com   # 任意: ALPHA_* 未設定時の base
ALPHA_US_PORTFOLIO_URL=   # 既定: {OSD_API_BASE}/api/alpha/portfolio/current
ALPHA_US_SCORECARD_URL=   # 既定: {OSD_API_BASE}/api/alpha/portfolio/scorecard
ALPHA_JP_PORTFOLIO_URL=   # 既定: {OSD_API_BASE}/api/alpha/jp/portfolio/current
ALPHA_JP_SCORECARD_URL=   # 既定: {OSD_API_BASE}/api/alpha/jp/scorecard
ALPHA_JP_CATALYSTS_URL=   # 既定: {OSD_API_BASE}/api/alpha/jp/catalysts

# ── Solana / Circle DCW ───────────────────────────────────────────────────────
# Circle Developer-Controlled Wallets API key
CIRCLE_API_KEY=

# Circle entity secret (32バイトの hex 文字列。Circle dashboard で生成・登録したもの)
CIRCLE_ENTITY_SECRET=

# Solana 決済の署名バックエンド: circle | privatekey (既定 privatekey)
# circle にすると Circle DCW ウォレットで署名し、秘密鍵をデプロイに置かずに済む。
# CIRCLE_SOLANA_WALLET_ID / CIRCLE_SOLANA_WALLET_ADDRESS が揃っている必要がある。
SOLANA_SIGNER_BACKEND=

# Solana 決済レグの署名鍵 (base58 の 64byte keypair。SOLANA_SIGNER_BACKEND=privatekey 用)
SOLANA_PRIVATE_KEY=

# Solana RPC (専用エンドポイント推奨)。未設定だと @x402/svm の既定
# https://api.mainnet-beta.solana.com を使う。公開エンドポイントはサーバからの
# 常時アクセスをレート制限するため、決済のトランザクション構築が失敗しうる。
SOLANA_RPC_URL=

# Circle が発行した Solana wallet ID / address（SOLANA_SIGNER_BACKEND=circle で本番決済に使用）
CIRCLE_SOLANA_WALLET_ID=
CIRCLE_SOLANA_WALLET_ADDRESS=

# LIVE の wallet set ID（circle-create-solana-wallet 用。Arc(TESTNET)では使わない）
CIRCLE_WALLET_SET_ID=

# Solana wallet address（Circle console で確認。表示・スクリプト用）
SOLANA_WALLET_ADDRESS=

# Hyre / PayAI endpoint URL overrides (任意 — 未設定時は TODO URL を使用)
HYRE_DEFI_INTELLIGENCE_URL=
HYRE_MARKET_SIGNALS_URL=

# Phase 1 外部データ wrappers (任意 — 未設定時はデフォルト URL を使用)
BIRDEYE_OHLCV_URL=

# World ID (Mode C の人間承認。RP signature / proof 検証に必須)
WLD_APP_ID=                 # app_... (World Developer Portal)
WLD_RP_ID=                  # rp_... (Relying Party ID)
WLD_SIGNING_KEY=            # RP signing key (hex)

# HTTP サーバー (Railway が自動で設定)
PORT=3000

# 通知 webhook (任意)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Arc Testnet ERC-8004 identity 登録 (独立スクリプト。AA 本体の cron には未接続) ──────
# Arc は Circle TEST キーを使う(AA 本体の LIVE 認証 CIRCLE_API_KEY/CIRCLE_ENTITY_SECRET とは別)。
# LIVE キーだと testnet で HTTP 400 / code 156006 になるため TEST キー必須。LIVE は上書きしない。
CIRCLE_API_KEY_TEST=             # Circle Console の Testnet で発行した TEST_API_KEY
CIRCLE_ENTITY_SECRET_TEST=       # Testnet 環境用の entity secret
# ウォレット作成(arc:create-wallets)。TEST 環境の wallet set。未設定なら初回実行時に新規作成し
# CIRCLE_WALLET_SET_ID_TEST=... をログに出す(控えれば次回以降は再作成しない)。LIVE の
# CIRCLE_WALLET_SET_ID は使わない(TEST キーからは見えず 156005 になるため)。
CIRCLE_WALLET_SET_ID_TEST=       # 任意。未設定なら arc:create-wallets が新規作成
# arc:create-wallets の出力を設定(register に必要)
CIRCLE_ARC_OWNER_WALLET_ID=      # Arc Testnet owner ウォレット(identity 登録・validation request)
CIRCLE_ARC_VALIDATOR_WALLET_ID=  # validator ウォレット(reputation 記録・validation response)
ARC_OWNER_ADDRESS=               # 記録用(表示のみ)
ARC_VALIDATOR_ADDRESS=           # validationRequest の validatorAddress 引数に使う
# 任意
ARC_AGENT_ID=                    # 未指定なら M0 記録の arc_agent_id(=845265)
ARC_METADATA_URI=               # ipfs:// 形式。未指定ならチュートリアルの例 IPFS URI で疎通確認
ARC_TESTNET_RPC=                # 未指定なら https://rpc.testnet.arc.network/

# ── Base Sepolia 買い手レグ (T8〜T9 デモ。既定 off) ────────────────────────────
# true にすると eip155:84532 を x402 クライアントに登録する。
X402_TESTNET_ENABLED=
# scripts/circle-create-base-sepolia-wallet の出力を設定。
# testnet なので Circle の TEST 認証 (CIRCLE_API_KEY_TEST / CIRCLE_ENTITY_SECRET_TEST) を使う。
CIRCLE_BASE_SEPOLIA_WALLET_ID=
CIRCLE_BASE_SEPOLIA_WALLET_ADDRESS=

# ── 週次 外部 x402 プローブ (5先。既定 off) ───────────────────────────────────
# true にすると毎週月 09:00 JST (00:00 UTC) に有料の sweep が走る。
# 先に `--probe-run0`(無課金の discovery)を回し、到達性・402・単価を確認してから true にする。
PROBE_ENABLED=
# 支払いウォレット。本番資金と分離した AA 専用の運用ウォレット(Base USDC)。
# 鍵は Circle DCW が保持し、AA は wallet id だけを持つ。生鍵は置かない。
CIRCLE_PROBE_WALLET_ID=
CIRCLE_PROBE_WALLET_ADDRESS=
# 上限(未設定時の既定): 1コール $0.20 / 1回 $2.00 / 週 $4.00
PROBE_PER_CALL_CAP_USD=
PROBE_PER_RUN_CAP_USD=
PROBE_WEEKLY_CAP_USD=
# probe ウォレットの残高警告閾値 (USDC)。未設定時は 5。
BALANCE_WARN_PROBE_USDC=

# ── 週次 catalyst sweep (osd の per-call を Solana で叩く。既定 off) ───────────
# 自走(推奨): true にすると AA が起動時に自分で run0(無課金)→ mainnet 1 ticker 実課金
# → 確認できたら週次sweepを有効化、まで回す。人間の手動 run は不要。冪等(Upstash に状態を
# 永続し、再デプロイで二度払わない。未確認なら止まる)。UPSTASH_REDIS_REST_* 必須。
CATALYST_AUTOPILOT=
# 手動ゲート(自走を使わない場合): 配線を人が確認した後、これで週次スケジュールだけ有効化。
# CATALYST_AUTOPILOT と両方 true なら autopilot を優先(二重スケジュールしない)。
CATALYST_SWEEP_ENABLED=
# 決済は既存の Solana レール(SOLANA_SIGNER_BACKEND=circle + CIRCLE_SOLANA_* / または
# SOLANA_PRIVATE_KEY)をそのまま使う。鍵は Circle DCW が保持。専用 SOLANA_RPC_URL 必須。
CATALYST_PRICE_UNITS=         # 1コールの base units。未設定時 1000 (=0.001 USDC)。osd の価格に合わせる
CATALYST_USDC_MINT=           # 未設定時 公式 Solana USDC mint。devnet スモーク時のみ上書き
CATALYST_WEEKLY_CAP_USD=      # 週上限 USDC。未設定時 0.50
CATALYST_RUN0_SAMPLE=         # run0 で 402 を確認する ticker 数。未設定時 3
# 叩き先の base は OSD_API_BASE (既定 https://osd.x402jp.com) を共用。一覧は GET /api/catalyst。

# ── 週次 EDINET sweep (osd の /api/edinet を Solana で叩く。既定 off) ──────────
# catalyst と同じエンジンの別 surface。状態キー(edinet_autopilot:state)・spend namespace
# (edinet)・CSV(data/edinet/) は catalyst と分離。決済レール/安全弁/署名は共有。
# 自走(推奨): EDINET_AUTOPILOT=true で run0 → mainnet 1件 → live → 週次(木 09:00 JST)を自走。
EDINET_AUTOPILOT=
# 手動ゲート: 配線を人が確認した後、週次スケジュールだけ有効化。両方 true なら autopilot 優先。
EDINET_SWEEP_ENABLED=
# 未設定時の既定は catalyst と同じ(1000 units=0.001 USDC / 公式mint / 週上限 $0.50 / sample 3)。
EDINET_PRICE_UNITS=
EDINET_USDC_MINT=
EDINET_WEEKLY_CAP_USD=
EDINET_RUN0_SAMPLE=
# 名簿(会社一覧)は GET /api/catalyst の197 ticker から取る。/api/edinet 自体はディスクリプタ
# のみで会社リストを返さないため。本体は GET /api/edinet/{ticker}(4桁 ticker をそのまま code に使う)。
EDINET_ROSTER_PATH=           # 未設定時 /api/catalyst。名簿の取得元だけ変えたいとき上書き
# EDINET_API_KEY は osd(売り手)側に設定。AA は叩くだけなので不要。
